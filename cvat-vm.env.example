# Copy to .env.vm beside CVAT's docker-compose.yml, then replace both image refs.
# Use the matching server/UI tag printed by scripts/docker/push-cvat.sh.
CVAT_SERVER_IMAGE=your-dockerhub-user/p116-cvat-server:REPLACE_WITH_RELEASE_TAG
CVAT_UI_IMAGE=your-dockerhub-user/p116-cvat-ui:REPLACE_WITH_RELEASE_TAG

# Hostname/IP only, without scheme or port. Must match the browser's hostname.
CVAT_HOST=localhost

# Docker Desktop host DNS; verify it reaches the API running inside Ubuntu WSL.
# If necessary, change HOST to the WSL address verified from the proxy container.
AUTOLABEL_API_HOST=host.docker.internal
AUTOLABEL_API_PORT=8000

# This is a CPU CVAT runtime. SAM/EgoBlur stay in WSL venvs, with their own env.
# Native Linux Docker Engine: set a reachable API host IP or add host-gateway
# in a separate Linux-only override; Desktop's DNS is intentionally preserved.
